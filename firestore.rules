rules_version = '2';

// Who can read and write what in the LittleJoy database.
// Paste this into Firebase Console → Firestore Database → Rules.
service cloud.firestore {
  match /databases/{database}/documents {

    // Each person's journey is private: only they can read or change it.
    match /users/{uid}/journey/{entryId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Community posts: anyone can look, signed-in people can post as themselves.
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 300;
      // Other people may only change the list of likes.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 300;
        allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      }
    }
  }
}
